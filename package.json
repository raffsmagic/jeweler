{
  "name": "jeweler",
  "version": "0.2.0",
  "description": "Tiny on-device models that score how likely a copied or typed text is a password, key or code. No network, no dependencies, under a millisecond.",
  "keywords": [
    "password",
    "secret",
    "credential",
    "detection",
    "clipboard",
    "on-device",
    "privacy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raffsmagic/jeweler.git"
  },
  "homepage": "https://github.com/raffsmagic/jeweler#readme",
  "bugs": {
    "url": "https://github.com/raffsmagic/jeweler/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "test:pack": "node scripts/smoke-pack.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build && npm run test:pack",
    "bench": "tsx bench/run.ts",
    "parity": "tsx runtime/parity.ts",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "tsx": "^4",
    "typescript": "^5",
    "@types/node": "^22"
  },
  "engines": {
    "node": ">=20"
  }
}
